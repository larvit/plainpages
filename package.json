{
  "name": "plainpages",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "imports": {
    "#menu-config": "./src/ui/menu-config.ts"
  },
  "scripts": {
    "start": "node src/server.ts",
    "dev": "node --watch src/server.ts",
    "gen-jwks": "node src/auth/gen-jwks.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"src/**/*.test.ts\" \"plugins/**/*.test.ts\" \"examples/**/*.test.ts\" \"registry-cleanup/**/*.test.ts\" \"release-tooling/**/*.test.ts\""
  },
  "dependencies": {
    "@larvit/log": "2.5.0",
    "ejs": "7.0.2",
    "lucide-static": "1.72.0",
    "postgres": "4.1.1"
  },
  "devDependencies": {
    "@mdn/browser-compat-data": "8.1.8",
    "@types/ejs": "3.1.5",
    "@types/node": "26.6.6",
    "acorn": "8.19.0",
    "typescript": "7.0.2"
  }
}
